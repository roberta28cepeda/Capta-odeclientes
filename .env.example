GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string-and-set-it-in-the-meta-dashboard-too

# Só necessário para o módulo fiscal_monitor em produção (Vercel/Postgres).
# Sem isso definida, fiscal_monitor usa SQLite local automaticamente.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Login de admin do dashboard fiscal_monitor (/tenants) — sem isso, acesso negado por padrão.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Só necessário para fiscal_monitor --check --enviar-email (alerta fiscal por e-mail).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM=alertas@seudominio.com.br

# Protege os endpoints de cron (/cron/check-all, /cron/campanhas/rodar) contra
# chamadas públicas — com essa variável configurada no projeto Vercel, o próprio
# Vercel Cron manda o Authorization: Bearer certo sozinho; sem ela, fica bloqueado.
CRON_SECRET=choose-any-secret-string

# Só necessário pro módulo campaigns (--buscar-emails) — Exa Search API
# (dashboard.exa.ai). $20 de bônus na criação + $10/mês grátis recorrente,
# sem cartão de crédito. Ver README > Módulo: Campanha de Prospecção (PGFN).
EXA_API_KEY=your-exa-api-key

# Opcional — módulo campaigns: quem recebe o relatório semanal de abertura/
# clique (toda segunda, via /cron/campanhas/rodar). Sem isso, cai no próprio
# SMTP_USERNAME.
RELATORIO_SEMANAL_EMAIL=contato@leactis.com.br

# Opcional — módulo campaigns: URL pública fixa usada nos links de rastreio
# (pixel de abertura, link de clique) dos e-mails. Sem isso, usa a URL da
# própria requisição do cron (funciona em produção, mas fica mais previsível
# com isso fixado, sobretudo com preview deployments).
PUBLIC_BASE_URL=https://capta-fiscal-monitor.vercel.app
