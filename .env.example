GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-secret-string-and-set-it-in-the-meta-dashboard-too

# Só necessário para o módulo fiscal_monitor em produção (Vercel/Postgres).
# Sem isso definida, fiscal_monitor usa SQLite local automaticamente.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Login de admin do dashboard fiscal_monitor (/tenants) — sem isso, acesso negado por padrão.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Só necessário para fiscal_monitor --check --enviar-email (alerta fiscal por e-mail).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=seu-usuario-smtp
SMTP_PASSWORD=sua-senha-smtp
SMTP_FROM=alertas@seudominio.com.br

# Protege o endpoint de checagem automática (/cron/check-all) contra chamadas públicas.
CRON_SECRET=choose-any-secret-string
