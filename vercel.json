{
  "builds": [{ "src": "api/index.py", "use": "@vercel/python" }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/cron/check-all", "schedule": "0 8 * * *" },
    { "path": "/cron/campanhas/rodar", "schedule": "0 12 * * *" }
  ]
}
